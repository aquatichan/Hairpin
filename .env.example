# Copy to .env.local for local dev. Never commit real values.
# In production these are set as Firebase App Hosting secrets / env.

# Firebase web config (public by design, safe in the browser bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Publik API (server-side only, never NEXT_PUBLIC_)
PUBLIK_API_BASE_URL=
PUBLIK_API_KEY=
