# Copy to .env.local for local dev. Never commit real values.
# In production these are set as Vercel environment variables (see DEPLOY.md).

# Firebase web config (public by design, safe in the browser bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=PLACEHOLDER_[FIREBASE_API_KEY]
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=PLACEHOLDER_[FIREBASE_AUTH_DOMAIN]
NEXT_PUBLIC_FIREBASE_PROJECT_ID=PLACEHOLDER_[FIREBASE_PROJECT_ID]
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=PLACEHOLDER_[FIREBASE_STORAGE_BUCKET]
NEXT_PUBLIC_FIREBASE_APP_ID=PLACEHOLDER_[FIREBASE_APP_ID]

# Publik API (server-side only, never NEXT_PUBLIC_)
# PUBLIK_API_BASE_URL defaults to https://publikhq.com/api/v1; set it only to override.
PUBLIK_API_KEY=PLACEHOLDER_[PUBLIK_API_KEY]
# Public app token (pat_...) and listing slug, used by the Publik sign-in gate
PUBLIK_APP_TOKEN=PLACEHOLDER_[PUBLIK_APP_TOKEN]
NEXT_PUBLIC_PUBLIK_APP_SLUG=PLACEHOLDER_[PUBLIK_APP_SLUG]

# Optional fallback if Publik is unavailable. Fallback spend does NOT count
# toward the fellowship score. Leave AI_FALLBACK empty to disable.
AI_FALLBACK=
OPENAI_API_KEY=PLACEHOLDER_[OPENAI_API_KEY]
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Set to 1 to exercise the try-on and brief flows without Publik. Results are
# labelled as demo output in the UI. Never set this in production.
PUBLIK_MOCK=
